# ══════════════════════════════════════════════════════════════
#  Sistema de Parqueadero — Variables de entorno
#  Copia este archivo como  .env  y ajusta los valores
# ══════════════════════════════════════════════════════════════

# ── Base de Datos MySQL ────────────────────────────────────────
DB_HOST=localhost          # En Docker usa el nombre del servicio: db
DB_USER=parkuser
DB_PASSWORD=parkpass123
DB_NAME=parqueadero_unimonserrate

# ── Autenticación JWT ──────────────────────────────────────────
JWT_SECRET=cambia-esta-clave-supersecreta-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=2880   # 48 horas

# ── Cuenta admin inicial ───────────────────────────────────────
ADMIN_EMAIL=admin@parqueadero.edu.co
ADMIN_PASSWORD=admin123

# ── Correo SMTP (Gmail) ────────────────────────────────────────
# Para activar el envío de facturas por email:
#   1. Activa la verificación en 2 pasos en tu cuenta Google.
#   2. Ve a myaccount.google.com → Seguridad → Contraseñas de aplicaciones.
#   3. Genera una contraseña de aplicación (16 caracteres sin espacios).
#   4. Copia ese valor en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tu-correo@gmail.com
MAIL_FROM_NAME=Parqueadero Unimonserrate

# ── Configuración del parqueadero ─────────────────────────────
CAPACIDAD_PARQUEADERO=100
